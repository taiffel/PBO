  object UpdateCidades: TZUpdateSQL
    DeleteSQL.Strings = (
      'DELETE FROM cidades'
      'WHERE'
      '  cidades.codigocidade = :OLD_codigocidade'
    )
    InsertSQL.Strings = (
      'INSERT INTO cidades'
      '  (codigocidade, nomecidade, codigoestado)'
      'VALUES'
      '  (:codigocidade, :nomecidade, :codigoestado)'
    )
    ModifySQL.Strings = (
      'UPDATE cidades SET'
      '  codigocidade = :codigocidade,'
      '  nomecidade = :nomecidade,'
      '  codigoestado = :codigoestado'
      'WHERE'
      '  cidades.codigocidade = :OLD_codigocidade'
    )
    UseSequenceFieldForRefreshSQL = False
    Left = 384
    Top = 40
    ParamData = <    
      item
        Name = 'codigocidade'
      end    
      item
        Name = 'nomecidade'
      end    
      item
        Name = 'codigoestado'
      end    
      item
        Name = 'OLD_codigocidade'
      end>
