  object QueryCidades: TZQuery
    Connection = FormPrincipal.Conn_PBD
    UpdateObject = UpdateCidades
    Active = True
    SQL.Strings = (
      'select c.*, e.nomeestado'
      'from estados e, cidades c'
      'where e.codigoestado=c.codigoestado'
    )
